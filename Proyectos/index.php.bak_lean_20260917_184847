$dir = __DIR__;

const ADEC_BASE_URL = 'https://sites.google.com/view/numeriprimi-teoremiecongetture/adec-engine/v0-8-6';
const ADEC_ANCHOR = '#h.4q0y44bfwvi3';

function h($value) {
    return htmlspecialchars((string) $value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

function starts_with($value, $prefix) {
    return substr((string) $value, 0, strlen($prefix)) === $prefix;
}

function preferred_language() {
    $header = strtolower($_SERVER['HTTP_ACCEPT_LANGUAGE'] ?? '');
    return starts_with($header, 'es') ? 'es' : 'en';
}

function label($es, $en) {
    return preferred_language() === 'en' ? $en : $es;
}

function public_file_url($file) {
    $https = (
        (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ||
        (($_SERVER['HTTP_X_FORWARDED_PROTO'] ?? '') === 'https')
    );
    $scheme = $https ? 'https' : 'http';
    $host = $_SERVER['HTTP_HOST'] ?? '';
    $path = rtrim(str_replace('\\', '/', dirname($_SERVER['SCRIPT_NAME'] ?? '')), '/');
    $encoded = implode('/', array_map('rawurlencode', explode('/', str_replace('\\', '/', $file))));

    return $scheme . '://' . $host . ($path ? $path : '') . '/' . $encoded;
}

function adec_url_for_json($jsonFile) {
    return ADEC_BASE_URL
        . '?json_url=' . rawurlencode(public_file_url($jsonFile))
        . '&authuser=0'
        . ADEC_ANCHOR;
}

function file_text_if_exists($path) {
    if (!is_file($path)) {
        return null;
    }

    $text = trim((string) file_get_contents($path));
    return $text === '' ? null : $text;
}

function project_files($base) {
    $files = [];

    foreach (['pdf', 'md', 'json', 'lean'] as $ext) {
        $name = $base . '.' . $ext;
        if (is_file(__DIR__ . DIRECTORY_SEPARATOR . $name)) {
            $files[$ext] = $name;
        }
    }

    return $files;
}

function project_image($dir, $base) {
    foreach ([$base . '.jpg', $base . '.jpeg', $base . '.png', $base . '.webp', 'image.jpg', 'image.png', 'image.webp'] as $name) {
        if (is_file($dir . DIRECTORY_SEPARATOR . $name)) {
            return $name;
        }
    }
    return null;
}

function license_badge($dir) {
    foreach (['licencia-etica-cc-by-nc-sa.svg', 'licencia-etica-cc-by-sa-nc.svg'] as $name) {
        if (is_file($dir . DIRECTORY_SEPARATOR . $name)) {
            return $name;
        }
    }
    return null;
}

$abstractHtml = file_text_if_exists($dir . DIRECTORY_SEPARATOR . 'abstract.html');
$licenseBadge = license_badge($dir);
$projects = [];

foreach (glob($dir . DIRECTORY_SEPARATOR . '*.json') ?: [] as $jsonPath) {
    $name = basename($jsonPath);
    if (starts_with($name, 'hashes')) {
        continue;
    }

    $base = pathinfo($name, PATHINFO_FILENAME);
    $raw = file_get_contents($jsonPath);
    $data = json_decode($raw, true);
    if (!is_array($data)) {
        $data = [];
    }

    $legacyAbstract = file_text_if_exists($dir . DIRECTORY_SEPARATOR . $base . '.abstract');
    $icon = is_file($dir . DIRECTORY_SEPARATOR . $base . '.ico') ? $base . '.ico' : null;

    $projects[] = [
        'base' => $base,
        'title' => $data['title'] ?? $base,
        'subtitle' => $data['subtitle'] ?? null,
        'author' => $data['author'] ?? null,
        'framework' => $data['framework'] ?? null,
        'revision' => $data['revision'] ?? null,
        'status' => $data['status'] ?? null,
        'generated_on' => $data['generated_on'] ?? null,
        'legacy_abstract' => $legacyAbstract,
        'image' => project_image($dir, $base),
        'icon' => $icon,
        'files' => project_files($base),
    ];
}

usort($projects, function ($a, $b) {
    return strcasecmp($a['base'], $b['base']);
});
