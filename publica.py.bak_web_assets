MARKDOWNS_DEMOSTRACIONES_WEB_PREPARADOS = set()


def _nombre_proyecto_web(project_spec):
    if isinstance(project_spec, tuple):
        project_spec = project_spec[0]
    return Path(project_spec).name


def _primer_archivo(candidatos):
    for candidato in candidatos:
        if candidato.exists():
            return candidato
    return None


def _index_proyectos_web():
    return _primer_archivo([
        PROJECT_ROOT / "proyectos" / "index.php",
        PROJECT_ROOT / "Proyectos" / "index.php",
    ])


def _proyecto_dir(project_name):
    return PROJECT_ROOT / "Proyectos" / project_name


def _markdown_proyecto(proyecto):
    return _primer_archivo([proyecto / f"{proyecto.name}.md"])


def preparar_markdowns_demostraciones_web(project_names):
    MARKDOWNS_DEMOSTRACIONES_WEB_PREPARADOS.clear()

    for project_spec in project_names:
        project_name = _nombre_proyecto_web(project_spec)
        markdown = _markdown_proyecto(_proyecto_dir(project_name))
        if markdown is None:
            print(f"⚠️ Falta {project_name}.md; no se preparará para generar PDF.")
            continue

        destino = PROJECT_ROOT / f"{project_name}.md"
        if destino.exists() and destino.resolve() != markdown.resolve():
            if destino.read_bytes() != markdown.read_bytes():
                print(f"⚠️ Ya existe {destino.name} en la raíz y no coincide con {markdown}; no se reemplaza.")
                continue

        shutil.copyfile(markdown, destino)
        os.utime(destino, None)
        MARKDOWNS_DEMOSTRACIONES_WEB_PREPARADOS.add(project_name)


def _limpiar_markdown_preparado(public_name, source):
    preparado = PROJECT_ROOT / f"{public_name}.md"
    if public_name not in MARKDOWNS_DEMOSTRACIONES_WEB_PREPARADOS:
        return
    if not preparado.exists() or source is None:
        return
    if preparado.resolve() != source.resolve() and preparado.read_bytes() == source.read_bytes():
        preparado.unlink()


def _mover_pdf_generado_al_proyecto(project_name, proyecto):
    pdf_generado = PROJECT_ROOT / "pdfs" / f"{project_name}.pdf"
    pdf_proyecto = proyecto / f"{project_name}.pdf"
    if not pdf_generado.exists():
        return _primer_archivo([pdf_proyecto])
    if pdf_generado.resolve() != pdf_proyecto.resolve():
        if pdf_proyecto.exists():
            pdf_proyecto.unlink()
        shutil.move(str(pdf_generado), str(pdf_proyecto))
    return pdf_proyecto


def preparar_demostraciones_web(project_names):
    index_php = _index_proyectos_web()

    for project_spec in project_names:
        project_name = _nombre_proyecto_web(project_spec)
        proyecto = _proyecto_dir(project_name)
        markdown_proyecto = _markdown_proyecto(proyecto)

        if index_php is None:
            print("⚠️ Falta proyectos/index.php; no se publicará el índice web.")
        else:
            shutil.copy2(index_php, proyecto / "index.php")

        artefactos_generados = {
            ".json": PROJECT_ROOT / "json" / f"{project_name}.json",
            ".lean": PROJECT_ROOT / "lean" / f"{project_name}.lean",
        }

        for extension, generado in artefactos_generados.items():
            destino = proyecto / f"{project_name}{extension}"
            if generado.exists():
                shutil.copy2(generado, destino)
                print(f"  ✅ {destino.name} actualizado desde {generado.parent.name}/")
            elif not destino.exists():
                print(f"⚠️ Falta {project_name}{extension}; no se publicará ese artefacto.")

        if not (proyecto / f"{project_name}.md").exists():
            print(f"⚠️ Falta {project_name}.md; no se publicará ese artefacto.")

        if _mover_pdf_generado_al_proyecto(project_name, proyecto) is None:
            print(f"⚠️ Falta {project_name}.pdf; no se publicará ese artefacto.")

